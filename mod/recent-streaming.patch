+// Custom mod: full-page "See more" view for the Recently Released sliders.
+import Header from '@app/components/Common/Header';
+import ListView from '@app/components/Common/ListView';
+import PageTitle from '@app/components/Common/PageTitle';
+import { sliderTitles } from '@app/components/Discover/constants';
+import useDiscover from '@app/hooks/useDiscover';
+import ErrorPage from '@app/pages/_error';
+import {
+  RECENT_MOVIE_URL,
+  RECENT_TV_URL,
+  recentMovieStreamingOptions,
+  recentTvStreamingOptions,
+} from '@app/utils/recentStreaming';
+import type { MovieResult, TvResult } from '@server/models/Search';
+import { useRouter } from 'next/router';
+import { useIntl } from 'react-intl';
+
+type RecentStreamingProps = {
+  mediaType: 'movies' | 'tv';
+};
+
+const RecentStreaming = ({ mediaType }: RecentStreamingProps) => {
+  const intl = useIntl();
+  const router = useRouter();
+  const data = typeof router.query.data === 'string' ? router.query.data : '';
+  const queryTitle =
+    typeof router.query.title === 'string' ? router.query.title : '';
+  const title =
+    queryTitle ||
+    intl.formatMessage(
+      mediaType === 'movies'
+        ? sliderTitles.recentmoviestreaming
+        : sliderTitles.recenttvstreaming
+    );
+
+  const {
+    isLoadingInitialData,
+    isEmpty,
+    isLoadingMore,
+    isReachingEnd,
+    titles,
+    fetchMore,
+    error,
+  } = useDiscover<MovieResult | TvResult>(
+    mediaType === 'movies' ? RECENT_MOVIE_URL : RECENT_TV_URL,
+    mediaType === 'movies'
+      ? recentMovieStreamingOptions(data)
+      : recentTvStreamingOptions(data)
+  );
+
+  if (error) {
+    return <ErrorPage statusCode={500} />;
+  }
+
+  return (
+    <>
+      <PageTitle title={title} />
+      <div className="mb-5 mt-1">
+        <Header>{title}</Header>
+      </div>
+      <ListView
+        items={titles}
+        isEmpty={isEmpty}
+        isLoading={
+          isLoadingInitialData || (isLoadingMore && (titles?.length ?? 0) > 0)
+        }
+        isReachingEnd={isReachingEnd}
+        onScrollBottom={fetchMore}
+      />
+    </>
+  );
+};
+
+export default RecentStreaming;
