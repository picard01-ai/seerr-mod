+// Custom mod: movies recently added to the selected streaming services.
+// Uses the Streaming Availability API when STREAMING_AVAILABILITY_API_KEY is
+// set, otherwise falls back to TMDB digital/TV release dates (last 90 days).
+const RECENT_PAGE_SIZE = 20;
+const recentMovieDetailCache = new Map<
+  string,
+  { source: RecentStreamingMovie[]; results: TmdbMovieResult[] }
+>();
+
+const mapWithConcurrency = async <T, R>(
+  items: T[],
+  limit: number,
+  fn: (item: T) => Promise<R>
+): Promise<R[]> => {
+  const results: R[] = new Array(items.length);
+  let next = 0;
+  const workers = Array.from(
+    { length: Math.min(limit, items.length) },
+    async () => {
+      while (next < items.length) {
+        const index = next++;
+        results[index] = await fn(items[index]);
+      }
+    }
+  );
+  await Promise.all(workers);
+  return results;
+};
+
+discoverRoutes.get('/movies/recent-streaming', async (req, res, next) => {
+  const tmdb = createTmdbWithRegionLanguage(req.user);
+  const page = Math.max(1, Number(req.query.page) || 1);
+  const watchRegion = String(req.query.watchRegion || 'US').toUpperCase();
+  const watchProviders = String(req.query.watchProviders || '');
+  const providerIds = watchProviders
+    .split('|')
+    .map((v) => Number(v))
+    .filter((v) => Number.isFinite(v) && v > 0);
+  const language = req.locale ?? (req.query.language as string | undefined);
+
+  const respond = async (
+    pageResults: TmdbMovieResult[],
+    totalResults: number
+  ) => {
+    const media = await Media.getRelatedMedia(
+      req.user,
+      pageResults.map((result) => ({
+        tmdbId: result.id,
+        mediaType: MediaType.MOVIE,
+      })),
+      { includeActiveRequest: true }
+    );
+    return res.status(200).json({
+      page,
+      totalPages: Math.max(1, Math.ceil(totalResults / RECENT_PAGE_SIZE)),
+      totalResults,
+      keywords: [],
+      results: pageResults.map((result) =>
+        mapMovieResult(
+          result,
+          media.find(
+            (m) => m.tmdbId === result.id && m.mediaType === MediaType.MOVIE
+          )
+        )
+      ),
+    });
+  };
+
+  try {
+    const sa = getStreamingAvailability();
+    if (sa && providerIds.length > 0) {
+      try {
+        const providers = await tmdb.getMovieWatchProviders({ watchRegion });
+        const names = providers
+          .filter((p) => providerIds.includes(p.provider_id))
+          .map((p) => p.provider_name);
+        const serviceIds = await sa.matchServices(watchRegion, names);
+
+        if (serviceIds.length > 0) {
+          const recent = await sa.getRecentMovies(watchRegion, serviceIds);
+          const cacheKey = `${watchRegion}|${serviceIds
+            .sort()
+            .join(',')}|${language ?? ''}`;
+          let cached = recentMovieDetailCache.get(cacheKey);
+
+          if (!cached || cached.source !== recent) {
+            const details = await mapWithConcurrency(recent, 6, async (m) => {
+              try {
+                return await tmdb.getMovie({ movieId: m.tmdbId, language });
+              } catch {
+                return null;
+              }
+            });
+            const results: TmdbMovieResult[] = details
+              .filter((d): d is NonNullable<typeof d> => !!d && !d.adult)
+              .map(
+                (d): TmdbMovieResult => ({
+                id: d.id,
+                media_type: 'movie',
+                adult: d.adult,
+                genre_ids: (d.genres ?? []).map((g) => g.id),
+                original_language: d.original_language,
+                original_title: d.original_title,
+                overview: d.overview ?? '',
+                popularity: d.popularity,
+                release_date: d.release_date,
+                title: d.title,
+                video: d.video,
+                vote_average: d.vote_average,
+                vote_count: d.vote_count,
+                backdrop_path: d.backdrop_path,
+                poster_path: d.poster_path,
+              })
+              )
+              .sort((a, b) => b.popularity - a.popularity);
+            cached = { source: recent, results };
+            recentMovieDetailCache.set(cacheKey, cached);
+          }
+
+          const start = (page - 1) * RECENT_PAGE_SIZE;
+          return await respond(
+            cached.results.slice(start, start + RECENT_PAGE_SIZE),
+            cached.results.length
+          );
+        }
+      } catch (e) {
+        logger.warn(
+          'Streaming Availability lookup failed; falling back to TMDB',
+          { label: 'API', errorMessage: e.message }
+        );
+      }
+    }
+
+    // Fallback: TMDB digital (4) / TV (6) releases in the last 90 days.
+    const day = 24 * 60 * 60 * 1000;
+    const iso = (t: number) => new Date(t).toISOString().split('T')[0];
+    const data = await tmdb.getDiscoverMovies({
+      page,
+      language,
+      watchRegion,
+      watchProviders: watchProviders || undefined,
+      watchMonetizationTypes: 'flatrate',
+      releaseDateGte: iso(Date.now() - 90 * day),
+      releaseDateLte: iso(Date.now()),
+      releaseType: '4|6',
+    });
