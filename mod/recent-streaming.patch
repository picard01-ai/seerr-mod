diff --git a/server/api/streamingavailability.ts b/server/api/streamingavailability.ts
new file mode 100644
index 0000000..4ae6a0d
--- /dev/null
+++ b/server/api/streamingavailability.ts
@@ -0,0 +1,264 @@
+// Custom mod: Streaming Availability API (movieofthenight.com) client.
+//
+// Used by the "Recently Released Movies (Streaming Services)" slider to find
+// movies that were *added to* the selected streaming services recently, which
+// TMDB cannot tell us.
+//
+// Configure with environment variables on the container:
+//   STREAMING_AVAILABILITY_API_KEY   your API key (required to enable this)
+//   STREAMING_AVAILABILITY_RAPIDAPI  "true" if the key came from rapidapi.com
+//                                    (default: key from movieofthenight.com)
+//   STREAMING_AVAILABILITY_MAX_PAGES pages of 25 changes fetched per refresh
+//                                    (default 8)
+//   STREAMING_AVAILABILITY_REFRESH_HOURS  how long results are reused
+//                                    (default 12)
+import logger from '@server/logger';
+import type { AxiosInstance } from 'axios';
+import axios from 'axios';
+
+const LABEL = 'Streaming Availability';
+const DAY = 24 * 60 * 60;
+
+interface SaService {
+  id: string;
+  name: string;
+}
+
+interface SaChange {
+  changeType: string;
+  itemType: string;
+  showId: string;
+  showType?: string;
+  streamingOptionType?: string;
+  service?: { id: string; name: string };
+  timestamp?: number;
+}
+
+interface SaShow {
+  id: string;
+  tmdbId?: string;
+  showType?: string;
+  title?: string;
+}
+
+interface SaChangesResult {
+  changes: SaChange[];
+  shows: Record<string, SaShow>;
+  hasMore: boolean;
+  nextCursor?: string;
+}
+
+export interface RecentStreamingMovie {
+  tmdbId: number;
+  addedAt: number; // unix seconds
+  serviceId: string;
+}
+
+const envNumber = (name: string, fallback: number): number => {
+  const value = Number(process.env[name]);
+  return Number.isFinite(value) && value > 0 ? value : fallback;
+};
+
+/** Lower-case a service name and strip words that differ between TMDB and SA. */
+export const normalizeServiceName = (name: string): string => {
+  let n = name.toLowerCase().replace(/\+/g, 'plus');
+  n = n.replace(
+    /\b(amazon|premium|standard|basic|essential|with ads|ads|channel|plus)\b/g,
+    ''
+  );
+  n = n.replace(/[^a-z0-9]/g, '');
+  n = n.replace(/plus$/, '');
+  if (n === 'max' || n === 'hbo') n = 'hbomax';
+  return n;
+};
+
+class StreamingAvailabilityAPI {
+  private axios: AxiosInstance;
+  private servicesCache = new Map<
+    string,
+    { at: number; services: SaService[] }
+  >();
+  private moviesCache = new Map<
+    string,
+    { at: number; movies: RecentStreamingMovie[] }
+  >();
+  private inFlight = new Map<string, Promise<RecentStreamingMovie[]>>();
+
+  constructor(apiKey: string, rapidApi: boolean) {
+    this.axios = axios.create({
+      baseURL: rapidApi
+        ? 'https://streaming-availability.p.rapidapi.com'
+        : 'https://api.movieofthenight.com/v4',
+      timeout: 20000,
+      headers: rapidApi
+        ? {
+            'X-RapidAPI-Key': apiKey,
+            'X-RapidAPI-Host': 'streaming-availability.p.rapidapi.com',
+          }
+        : { 'X-API-Key': apiKey },
+    });
+  }
+
+  private refreshSeconds(): number {
+    return envNumber('STREAMING_AVAILABILITY_REFRESH_HOURS', 12) * 3600;
+  }
+
+  /** Services available in a country (cached for a day). */
+  public async getServices(country: string): Promise<SaService[]> {
+    const key = country.toLowerCase();
+    const now = Date.now() / 1000;
+    const cached = this.servicesCache.get(key);
+    if (cached && now - cached.at < DAY) {
+      return cached.services;
+    }
+    const response = await this.axios.get<{
+      services?: { id: string; name: string }[];
+    }>(`/countries/${key}`, { params: { output_language: 'en' } });
+    const services = (response.data.services ?? []).map((s) => ({
+      id: s.id,
+      name: s.name,
+    }));
+    this.servicesCache.set(key, { at: now, services });
+    return services;
+  }
+
+  /** Match TMDB provider names to Streaming Availability service ids. */
+  public async matchServices(
+    country: string,
+    providerNames: string[]
+  ): Promise<string[]> {
+    const services = await this.getServices(country);
+    const ids = new Set<string>();
+    for (const providerName of providerNames) {
+      const wanted = normalizeServiceName(providerName);
+      const match =
+        services.find((s) => normalizeServiceName(s.name) === wanted) ??
+        services.find((s) => s.id === wanted) ??
+        services.find((s) => {
+          const n = normalizeServiceName(s.name);
+          return n.length > 2 && (wanted.startsWith(n) || n.startsWith(wanted));
+        });
+      if (match) {
+        ids.add(match.id);
+      } else {
+        logger.debug(`No Streaming Availability service for "${providerName}"`, {
+          label: LABEL,
+        });
+      }
+    }
+    return [...ids];
+  }
+
+  /**
+   * Movies newly added (with a subscription) to the given services in the
+   * last 30 days, newest first. Cached per country + service list.
+   */
+  public async getRecentMovies(
+    country: string,
+    serviceIds: string[]
+  ): Promise<RecentStreamingMovie[]> {
+    const services = [...serviceIds].sort();
+    const key = `${country.toLowerCase()}|${services.join(',')}`;
+    const now = Math.floor(Date.now() / 1000);
+    const cached = this.moviesCache.get(key);
+    if (cached && now - cached.at < this.refreshSeconds()) {
+      return cached.movies;
+    }
+    const pending = this.inFlight.get(key);
+    if (pending) {
+      return pending;
+    }
+
+    const promise = this.fetchRecentMovies(country, services, now)
+      .then((movies) => {
+        this.moviesCache.set(key, { at: now, movies });
+        return movies;
+      })
+      .catch((e) => {
+        if (cached) {
+          logger.warn('Using older results after a refresh failed', {
+            label: LABEL,
+            errorMessage: e.message,
+          });
+          return cached.movies;
+        }
+        throw e;
+      })
+      .finally(() => this.inFlight.delete(key));
+    this.inFlight.set(key, promise);
+    return promise;
+  }
+
+  private async fetchRecentMovies(
+    country: string,
+    services: string[],
+    now: number
+  ): Promise<RecentStreamingMovie[]> {
+    const maxPages = envNumber('STREAMING_AVAILABILITY_MAX_PAGES', 8);
+    const catalogs = services.map((s) => `${s}.subscription`).join(',');
+    const seen = new Map<number, RecentStreamingMovie>();
+    let cursor: string | undefined;
+
+    for (let page = 0; page < maxPages; page++) {
+      const response = await this.axios.get<SaChangesResult>('/changes', {
+        params: {
+          country: country.toLowerCase(),
+          catalogs,
+          change_type: 'new',
+          item_type: 'show',
+          show_type: 'movie',
+          from: now - 30 * DAY,
+          order_direction: 'desc',
+          output_language: 'en',
+          cursor,
+        },
+      });
+      const { changes = [], shows = {}, hasMore, nextCursor } = response.data;
+
+      for (const change of changes) {
+        const tmdb = shows[change.showId]?.tmdbId; // e.g. "movie/597"
+        const match = tmdb?.match(/^movie\/(\d+)$/);
+        if (!match) continue;
+        const tmdbId = Number(match[1]);
+        if (!seen.has(tmdbId)) {
+          seen.set(tmdbId, {
+            tmdbId,
+            addedAt: change.timestamp ?? now,
+            serviceId: change.service?.id ?? '',
+          });
+        }
+      }
+
+      if (!hasMore || !nextCursor) break;
+      cursor = nextCursor;
+    }
+
+    logger.info(
+      `Fetched ${seen.size} recently added movies for ${country.toUpperCase()} (${services.join(', ')})`,
+      { label: LABEL }
+    );
+    return [...seen.values()];
+  }
+}
+
+let instance: StreamingAvailabilityAPI | null | undefined;
+
+/** Returns the client, or null when no API key is configured. */
+export const getStreamingAvailability = (): StreamingAvailabilityAPI | null => {
+  if (instance === undefined) {
+    const apiKey = process.env.STREAMING_AVAILABILITY_API_KEY?.trim();
+    instance = apiKey
+      ? new StreamingAvailabilityAPI(
+          apiKey,
+          process.env.STREAMING_AVAILABILITY_RAPIDAPI === 'true'
+        )
+      : null;
+    if (!instance) {
+      logger.info(
+        'STREAMING_AVAILABILITY_API_KEY not set; recent movie slider uses TMDB dates',
+        { label: LABEL }
+      );
+    }
+  }
+  return instance;
+};
