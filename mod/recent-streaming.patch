+// Custom mod: "recently released on streaming services" Discover sliders.
+//
+// Slider data uses the same format as the built-in streaming-service sliders:
+// "<region>,<providerId>|<providerId>|..." (for example "US,8|1899|337").
+//
+// Movies come from /api/v1/discover/movies/recent-streaming, which uses the
+// Streaming Availability API (date each movie was added to the service) when
+// STREAMING_AVAILABILITY_API_KEY is set, and TMDB release dates otherwise.
+//
+// Series use TMDB directly. The date window is calculated each time the slider
+// loads, so it always covers the last N days.
+
+export const RECENT_MOVIE_URL = '/api/v1/discover/movies/recent-streaming';
+export const RECENT_TV_URL = '/api/v1/discover/tv';
+
+/**
+ * How far back a series' most recent episode may have aired. Because this
+ * checks every episode's air date (not just the premiere), a returning show
+ * with a new season counts as recently released.
+ */
+export const RECENT_TV_DAYS = 60;
+
+/**
+ * TMDB TV genres left out of the series slider so that daily or weekly
+ * programmes don't crowd out actual new seasons:
+ * 10763 News, 10766 Soap, 10767 Talk.
+ */
+export const RECENT_TV_EXCLUDED_GENRES = '10763|10766|10767';
+
+const isoDaysAgo = (days: number): string =>
+  new Date(Date.now() - days * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
+
+const splitData = (data?: string | null) => {
+  const [region = '', providers = ''] = (data ?? '').split(',');
+  return { region, providers };
+};
+
+/** Query parameters (unencoded) for the movie slider / page. */
+export const recentMovieStreamingOptions = (
+  data?: string | null
+): Record<string, string> => {
+  const { region, providers } = splitData(data);
+  return { watchRegion: region, watchProviders: providers };
+};
+
+/** Query parameters (unencoded) for the series slider / page. */
+export const recentTvStreamingOptions = (
+  data?: string | null
+): Record<string, string> => {
+  const { region, providers } = splitData(data);
+  return {
+    watchRegion: region,
+    watchProviders: providers,
+    watchMonetizationTypes: 'flatrate',
+    airDateGte: isoDaysAgo(RECENT_TV_DAYS),
+    airDateLte: isoDaysAgo(0),
+    excludeGenres: RECENT_TV_EXCLUDED_GENRES,
+    sortBy: 'popularity.desc',
+  };
+};
+
+const toQuery = (options: Record<string, string>): string =>
+  Object.entries(options)
+    .map(([key, value]) => `${key}=${encodeURIComponent(value)}`)
+    .join('&');
+
+export const recentMovieStreamingParams = (data?: string | null): string =>
+  toQuery(recentMovieStreamingOptions(data));
+
+export const recentTvStreamingParams = (data?: string | null): string =>
+  toQuery(recentTvStreamingOptions(data));
+
+/** "See more" page link for a slider. */
+export const recentStreamingLink = (
+  mediaType: 'movies' | 'tv',
+  data?: string | null,
+  title?: string | null
+): string =>
+  `/discover/recent/${mediaType}?${toQuery({
+    data: data ?? '',
+    title: title ?? '',
+  })}`;
